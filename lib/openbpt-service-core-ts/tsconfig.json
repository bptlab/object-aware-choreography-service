{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017"],
    "declaration": true,
    "declarationDir": "build/types",
    "module": "CommonJS",
    "rootDir": "src",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "build", "eslint.config.mjs"]
}
