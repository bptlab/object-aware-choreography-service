objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, task_task2, task_task3
  
  RoleA -> RoleB: task1 [out case_id key, out attribute_classa_a-id, out attribute_classa_att1]
  RoleA -> RoleB: task2 [in case_id key, out completed, out task_task2]
  RoleB -> RoleA: task3 [in case_id key, out completed, out task_task3]
}