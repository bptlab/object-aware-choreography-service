objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, state_classa_a-y, task_task1, task_task2, task_task4, task_task5, task_task6
  
  RoleA -> RoleB: task1 [out case_id key, out task_task1]
  RoleA -> RoleB: task2 [in case_id key, in attribute_classa_a-id, in attribute_classa_att1, in state_classa_a-y, out task_task2]
  RoleA -> RoleB: task3 [in case_id key, out attribute_classa_a-id, out attribute_classa_att1]
  RoleA -> RoleB: task4 [in case_id key, out task_task4]
  RoleA -> RoleB: task5 [in case_id key, out task_task5]
  RoleA -> RoleB: task6 [in case_id key, out completed, out task_task6]
}