objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, attribute_classa_att2, task_task1
  
  RoleA -> RoleB: task1 [out case_id key, out task_task1]
  RoleA -> RoleB: task2 [in case_id key, out attribute_classa_a-id, out attribute_classa_att1, out completed]
  RoleA -> RoleB: task3 [in case_id key, out attribute_classa_a-id, out attribute_classa_att2, out completed]
}