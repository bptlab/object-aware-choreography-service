objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1
  
  RoleA -> RoleB: task1 [out case_id key, out attribute_classa_a-id]
  RoleB -> RoleA: task2 [in case_id key, in attribute_classa_a-id, out attribute_classa_att1, out completed]
}