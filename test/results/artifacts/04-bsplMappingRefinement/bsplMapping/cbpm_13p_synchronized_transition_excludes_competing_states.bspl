objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, attribute_classa_att2, state_classa_a-y, task_sync-task
  
  RoleA -> RoleB: sync-task [in case_id key, in attribute_classa_a-id, in attribute_classa_att1, out completed, out state_classa_a-y, out task_sync-task, nil attribute_classa_att2]
  RoleA -> RoleB: task1 [out case_id key, out attribute_classa_a-id, out attribute_classa_att1]
}