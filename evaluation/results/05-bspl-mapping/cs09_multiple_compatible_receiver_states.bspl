objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, attribute_classa_att2, attribute_classa_att3, task_task1
  
  RoleA -> RoleB: task1 [out case_id key, out task_task1]
  RoleA -> RoleB: task2 [in case_id key, out attribute_classa_a-id, out attribute_classa_att2]
  RoleA -> RoleB: task3 [in case_id key, out attribute_classa_a-id, out attribute_classa_att1]
  RoleB -> RoleA: task4 [in case_id key, in attribute_classa_a-id, in attribute_classa_att1, out attribute_classa_att3, out completed]
  RoleB -> RoleA: task4 [in case_id key, in attribute_classa_a-id, in attribute_classa_att2, out attribute_classa_att3, out completed]
}