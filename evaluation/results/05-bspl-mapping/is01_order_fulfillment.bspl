objectawarechoreographyprotocol {
  roles Buyer, Seller, Warehouse
  parameters out case_id key, out completed
  private attribute_invoice_invoice-id, attribute_invoice_total, attribute_invoice_transaction-id, attribute_order_accepted, attribute_order_item, attribute_order_order-id, attribute_shipment-request_on-hold, attribute_shipment-request_released, attribute_shipment-request_shipment-req-id, attribute_shipment_shipment-id, attribute_shipment_weight, state_order_canceled, state_order_fulfilled, state_shipment-request_released, state_shipment_delivered, task_co-cancel-order, task_pd-report-planned-delivery, task_rl-release-shipment
  
  Buyer -> Seller: co-cancel-order [in case_id key, in attribute_order_item, in attribute_order_order-id, out completed, out state_order_canceled, out task_co-cancel-order, nil attribute_order_accepted, nil state_order_fulfilled]
  Buyer -> Seller: co-cancel-order [in case_id key, in attribute_order_accepted, in attribute_order_item, in attribute_order_order-id, out completed, out state_order_canceled, out task_co-cancel-order, nil state_order_fulfilled]
  Warehouse -> Buyer: dg-deliver-goods [in case_id key, in attribute_order_item, in attribute_order_order-id, in attribute_shipment-request_shipment-req-id, out attribute_shipment_shipment-id, out attribute_shipment_weight, out completed, out state_order_fulfilled, out state_shipment_delivered, nil attribute_order_accepted, nil state_order_canceled]
  Warehouse -> Buyer: dg-deliver-goods [in case_id key, in attribute_order_accepted, in attribute_order_item, in attribute_order_order-id, in attribute_shipment-request_shipment-req-id, out attribute_shipment_shipment-id, out attribute_shipment_weight, out completed, out state_order_fulfilled, out state_shipment_delivered, nil state_order_canceled]
  Seller -> Warehouse: fo-forward-order-details [in case_id key, in attribute_order_item, in attribute_order_order-id, out attribute_order_accepted, nil state_order_canceled, nil state_order_fulfilled]
  Warehouse -> Seller: pd-report-planned-delivery [in case_id key, out task_pd-report-planned-delivery]
  Buyer -> Seller: po-place-order [out case_id key, out attribute_order_item, out attribute_order_order-id]
  Buyer -> Seller: pp-send-payment-proof [in case_id key, in attribute_invoice_invoice-id, in attribute_invoice_total, out attribute_invoice_transaction-id]
  Seller -> Warehouse: rl-release-shipment [in case_id key, in attribute_shipment-request_on-hold, in attribute_shipment-request_shipment-req-id, out state_shipment-request_released, out task_rl-release-shipment]
  Seller -> Warehouse: rs-request-shipment-1 [in case_id key, in attribute_order_item, in attribute_order_order-id, out attribute_shipment-request_released, out attribute_shipment-request_shipment-req-id]
  Seller -> Warehouse: rs-request-shipment-2 [in case_id key, in attribute_order_item, in attribute_order_order-id, out attribute_shipment-request_on-hold, out attribute_shipment-request_shipment-req-id]
  Seller -> Buyer: si-send-invoice [in case_id key, in attribute_order_item, in attribute_order_order-id, out attribute_invoice_invoice-id, out attribute_invoice_total]
}