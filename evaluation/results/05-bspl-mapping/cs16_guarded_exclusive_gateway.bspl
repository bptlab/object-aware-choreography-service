objectawarechoreographyprotocol {
  roles RoleA, RoleB
  parameters out case_id key, out completed
  private attribute_classa_a-id, attribute_classa_att1, attribute_classa_att2, task_task1, task_task4, task_task5
  
  RoleA -> RoleB: task1 [out case_id key, out task_task1]
  RoleA -> RoleB: task2 [in case_id key, out attribute_classa_a-id, out attribute_classa_att1]
  RoleA -> RoleB: task3 [in case_id key, out attribute_classa_a-id, out attribute_classa_att2]
  RoleA -> RoleB: task4 [in case_id key, out completed, out task_task4]
  RoleA -> RoleB: task5 [in case_id key, out completed, out task_task5]
}